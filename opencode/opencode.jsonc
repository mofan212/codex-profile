{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "~/.codex/AGENTS.md"
  ],
  "provider": {
    "custom": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "{env:OPENCODE_CUSTOM_BASE_URL}"
      },
      "models": {
        "kimi-k3": {
          "name": "kimi-k3",
          "reasoning": true,
          "interleaved": "reasoning_content",
          "limit": {
            "context": 1048576,
            "output": 131072
          },
          "options": {
            "reasoningEffort": "xhigh"
          }
        },
        "gpt-5.6-sol": {
          "name": "gpt-5.6-sol",
          "reasoning": true,
          "interleaved": "reasoning_content",
          "limit": {
            "context": 258400,
            "input": 130400,
            "output": 128000
          },
          "variants": {
            "xhigh": {
              "reasoningEffort": "xhigh"
            },
            "medium": {
              "reasoningEffort": "medium"
            }
          }
        },
        "glm-5.3": {
          "name": "glm-5.3",
          "reasoning": true,
          "interleaved": "reasoning_content",
          "limit": {
            "context": 1000000,
            "output": 131072
          },
          "options": {
            "reasoningEffort": "high"
          }
        }
      }
    }
  }
}